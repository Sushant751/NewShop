{
    "ConnectionStrings": {
        "DefaultConnection": "Server=localhost;Database=BillingSystem;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;"
    },
    "Jwt": {
        "Issuer": "BillingSystem",
        "Audience": "BillingSystemClients",
        "SecretKey": "SuperSecretKey_Change_In_Production_At_Least_32_Characters_Long_2026!",
        "AccessTokenMinutes": 15,
        "RefreshTokenDays": 7,
        "MaxFailedAttempts": 5,
        "LockoutMinutes": 15
    },
    "Cache": {
        "ConnectionString": "localhost:6379",
        "InstanceName": "billing",
        "DefaultTtlSeconds": 300
    },
    "Cors": {
        "AllowedOrigins": [
            "http://localhost:5173",
            "http://localhost:3000"
        ]
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning"
            }
        },
        "FilePath": "logs/billing-.log",
        "RollingInterval": "Day",
        "RetainedFileCountLimit": 31,
        "WriteTo": [
            {
                "Name": "Async",
                "Args": {
                    "configure": [
                        {
                            "Name": "Console"
                        }
                    ]
                }
            },
            {
                "Name": "Async",
                "Args": {
                    "configure": [
                        {
                            "Name": "File",
                            "Args": {
                                "path": "logs/billing-.log",
                                "rollingInterval": "Day",
                                "retainedFileCountLimit": 31
                            }
                        }
                    ]
                }
            }
        ]
    },
    "AllowedHosts": "*"
}