# ==============================================================================
# .env.example — Multi-Tenant Billing & POS SaaS Application
# ==============================================================================
# Copy this file to ".env" and adjust the values for your environment:
#
#   copy .env.example .env      (Windows cmd)
#   cp .env.example .env        (Linux / macOS)
#
# Docker Compose automatically reads a ".env" file in the project root and
# substitutes the variables below into docker-compose.yml.
# NEVER commit the real ".env" file to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# SQL Server (sa password must be at least 8 chars, mixed case, digits, symbols)
# ------------------------------------------------------------------------------
DB_SA_PASSWORD=YourStrong!Passw0rd
DB_PORT=1433

# ------------------------------------------------------------------------------
# Redis cache
# ------------------------------------------------------------------------------
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# JWT — secret key MUST be at least 32 characters in production
# Generate one with: openssl rand -base64 48
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=SuperSecretKey_Change_In_Production_At_Least_32_Characters_Long_2026!

# ------------------------------------------------------------------------------
# Host port mappings (container internal ports are fixed)
#   API container listens on 8080  -> mapped to API_PORT on host
#   Frontend container listens on 80 -> mapped to FRONTEND_PORT on host
# ------------------------------------------------------------------------------
API_PORT=5000
FRONTEND_PORT=8081
